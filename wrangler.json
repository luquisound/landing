{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luquisound-landing",
  "account_id": "b47cbdc6d9efa7d71fd1dd2ef8e5aa37",
  "main": "./dist/worker.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "routes": [
    { "pattern": "luquisound.com", "custom_domain": true },
    { "pattern": "www.luquisound.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/*.html",
      "/assets/*.mp4"
    ],
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
