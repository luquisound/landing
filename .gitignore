# Deny by default: additions to the public tree require an explicit review.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/AGENTS.md
!/README.md
!/SECURITY.md
!/CONTRIBUTING.md
!/package.json
!/package-lock.json
!/public-files.json
!/.github/
!/docs/
!/scripts/
!/tests/

/.github/*
!/.github/CODEOWNERS
!/.github/dependabot.yml
!/.github/pull_request_template.md
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
!/.github/workflows/codeql.yml
/docs/*
!/docs/security-baseline.md
!/docs/github-settings/
/docs/github-settings/*
!/docs/github-settings/*.json
/scripts/*
!/scripts/check-public.mjs
!/scripts/public-policy.mjs
/tests/*
!/tests/public-policy.test.mjs

# Machine-local context, secrets and disposable artifacts stay private.
.env
.env.*
!.env.example
!.env.*.example
*.local.*
*.pem
*.key
*.p12
*.pfx
node_modules/
dist/
coverage/
/.agent-tmp/
/.codex-remote-attachments/
/docs/project-context.local.md
**/PROVENANCE.md

# Selected website files; all other prototype and source media stay private.
!/scripts/preview-site.mjs
!/tests/preview-site.test.mjs
!/docs/frontend.md
!/site/
/site/*
!/site/assets/
/site/assets/*
!/site/index.html
!/site/servicios.html
!/site/trabajos.html
!/site/contacto.html
!/site/styles.css
!/site/app.js
!/site/cases.js
